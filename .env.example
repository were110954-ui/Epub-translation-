# 복사해서 .env 로 저장하세요 (copy .env.example .env). 웹 UI의 "API 키 저장"을 써도 됩니다.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI 호환 서버 (Ollama, LM Studio, vLLM 등)
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
# EPUBCheck (선택): Java + epubcheck.jar. tools/epubcheck/epubcheck.jar 가 있으면 자동 사용
# EPUBCHECK_JAR=C:\tools\epubcheck\epubcheck.jar
# JAVA_BIN=C:\Program Files\Java\bin\java.exe
# 데이터(작업 DB, 결과) 폴더
# EPUB_TRANSLATOR_DATA=./data
# 만화 OCR (선택). auto | tesseract | rapidocr | easyocr. fixture는 테스트 전용.
# EPUB_OCR_BACKEND=auto
# EPUB_OCR_GPU=auto
# 테스트용으로 페이지 작업에 지연을 줄 때만 사용합니다.
# EPUB_PAGE_DELAY=0
